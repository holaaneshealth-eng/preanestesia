{
  "name": "preanestesia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AnesHealth · Programa de apoyo a la entrevista preanestésica de enfermería",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && OFUSCAR=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "verificar:despliegue": "node --experimental-strip-types scripts/comprobar-despliegue.ts",
    "informe:casos": "node --experimental-strip-types scripts/generar-informe-casos.ts",
    "contenido:clinico": "node --experimental-strip-types scripts/generar-contenido-clinico.ts",
    "lista:nombres": "node --experimental-strip-types scripts/generar-lista-nombres.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
